<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.akidukisystems</groupId>
  <artifactId>notify</artifactId>
  <name>notify</name>
  <version>0.0.1-SNAPSHOT</version>
  <description>デスクトップ壁紙に時計・天気予報・気象警報を表示するJavaFX製の常駐アプリ</description>
  <url>https://github.com/akidukisystems/notify</url>
  <developers>
    <developer>
      <id>akidukisystems</id>
      <name>akidukisystems</name>
      <email>densyamc@gmail.com</email>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/akidukisystems/notify.git</connection>
    <developerConnection>scm:git:https://github.com/akidukisystems/notify.git</developerConnection>
    <url>https://github.com/akidukisystems/notify</url>
  </scm>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.akidukisystems.notify.notifyapp.NotifyApplication</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>
  <properties>
    <maven.compiler.target>25</maven.compiler.target>
    <java.version>25</java.version>
    <maven.compiler.source>25</maven.compiler.source>
  </properties>
</project>
